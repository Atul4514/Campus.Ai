# Required Django settings
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional persistent PostgreSQL connection. Leave blank to use local SQLite.
DATABASE_URL=

# Optional SMTP credentials for password reset and email notifications
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
